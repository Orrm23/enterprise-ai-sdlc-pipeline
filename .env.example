# ==============================================================================
# Enterprise AI SDLC Environment Configuration Template
# ==============================================================================

# Option A: Azure OpenAI Service (Recommended for Enterprise Azure DevOps)
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=your_azure_openai_api_key_here
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o
AZURE_OPENAI_API_VERSION=2024-06-01

# Option B: Direct OpenAI API
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-4o

# Azure DevOps Context (Automatically populated inside Azure Pipelines)
# In Azure DevOps pipelines, System.AccessToken is automatically injected.
SYSTEM_ACCESSTOKEN=
SYSTEM_COLLECTIONURI=https://dev.azure.com/your-organization/
SYSTEM_TEAMPROJECT=your-project-name
BUILD_REPOSITORY_ID=your-repo-id
SYSTEM_PULLREQUEST_PULLREQUESTID=

# AI Governance Settings
ENFORCE_AI_GATES=false
